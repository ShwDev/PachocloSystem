# Copie este archivo a .env y cambie los valores. .env está en .gitignore: nunca se sube.
# Los valores de abajo son SOLO de ejemplo para desarrollo.

# ---- Imágenes (Docker Hub: https://hub.docker.com/u/twcfine) ----
DOCKERHUB_USER=twcfine
IMAGE_TAG=1.0

# ---- Frontend ----
# Puerto del host donde se abre la aplicación: http://localhost:4200
FRONTEND_PORT=4200
# Puerto de la app React de Medicamentos (solo docker-compose.yml): http://localhost:4300
FRONTEND_REACT_PORT=4300

# ---- Perfil de Spring ----
# Vacío = desarrollo (sin las validaciones estrictas). "prod" exige CORS_ORIGENES con https.
SPRING_PROFILES_ACTIVE=

# ---- Secretos compartidos ----
# Mínimo 32 bytes.
JWT_SECRET=secreto-jwt-ejemplo-solo-desarrollo-0123456789
# Mínimo 32 caracteres; debe ser la MISMA en las dos APIs (el compose ya la reparte).
MEDICAMENTOS_API_KEY=clave-servicio-ejemplo-solo-desarrollo-0123456789

# ---- Administrador inicial (solo se aplica la primera vez, al crearlo en la base) ----
ADMIN_USERNAME=admin
# Mínimo 10 caracteres.
ADMIN_PASSWORD=admin-ejemplo-2026

# ---- Bases de Datos MongoDB ----
# URI de conexión de cada servicio (incluye la base de datos). Estos valores son
# los que usa docker compose: "mongo" es el nombre del servicio de MongoDB y
# replicaSet=rs0 es obligatorio para las transacciones. Para arrancar los
# servicios fuera de Docker, sustituya "mongo:27017" por "localhost:27017" y
# apunte a un mongod con replica set (ver README).
# En producción ponga su cadena real (p. ej. de Atlas) en .env, que nunca se sube
# al repositorio.
PACHOCLO_MONGO_URI=mongodb://mongo:27017/pachoclosystem?replicaSet=rs0
MEDICAMENTOS_MONGO_URI=mongodb://mongo:27017/medicamentos?replicaSet=rs0

# ---- Red y CORS ----
# Frontend y API comparten origen (nginx hace de proxy), así que no hace falta CORS.
# Solo defínalo con SPRING_PROFILES_ACTIVE=prod (admite únicamente orígenes https).
CORS_ORIGENES=
# IPs fijas de los nginx en la red "publica" (subred 172.28.10.0/24 del compose). Son los
# únicos proxies de confianza: solo de ellos se acepta X-Forwarded-For para el límite de
# intentos de login. No ponga la subred entera: incluye la puerta de enlace y permitiría
# falsificar la IP.
NGINX_IP=172.28.10.10
# nginx de la app React (frontend-react/); solo lo usa docker-compose.yml.
NGINX_REACT_IP=172.28.10.11
