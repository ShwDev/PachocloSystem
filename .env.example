# Copie este archivo a .env y cambie los valores. .env está en .gitignore: nunca se sube.
# Los valores de abajo son SOLO de ejemplo para desarrollo.

# ---- Imágenes (Docker Hub: https://hub.docker.com/u/twcfine) ----
DOCKERHUB_USER=twcfine
IMAGE_TAG=1.0

# ---- Frontend ----
# Puerto del host donde se abre la aplicación: http://localhost:4200
FRONTEND_PORT=4200

# ---- Perfil de Spring ----
# Vacío = desarrollo (sin las validaciones estrictas). "prod" exige CORS_ORIGENES con https.
SPRING_PROFILES_ACTIVE=

# ---- Secretos compartidos ----
# Mínimo 32 bytes.
JWT_SECRET=secreto-jwt-ejemplo-solo-desarrollo-0123456789
# Mínimo 32 caracteres; debe ser la MISMA en las dos APIs (el compose ya la reparte).
MEDICAMENTOS_API_KEY=clave-servicio-ejemplo-solo-desarrollo-0123456789

# ---- Administrador inicial (solo se aplica la primera vez, al crearlo en la base) ----
ADMIN_USERNAME=admin
# Mínimo 10 caracteres.
ADMIN_PASSWORD=admin-ejemplo-2026

# ---- Bases de Datos MongoDB Atlas (Formato Legacy / Directo) ----
PACHOCLO_MONGO_URI=mongodb://admin:admin@ac-sfjv6wg-shard-00-00.vwsmy77.mongodb.net:27017,ac-sfjv6wg-shard-00-01.vwsmy77.mongodb.net:27017,ac-sfjv6wg-shard-00-02.vwsmy77.mongodb.net:27017/pachoclosystem?ssl=true&replicaSet=atlas-nitjzr-shard-0&authSource=admin&retryWrites=true&w=majority

MEDICAMENTOS_MONGO_URI=mongodb://admin:admin@ac-sfjv6wg-shard-00-00.vwsmy77.mongodb.net:27017,ac-sfjv6wg-shard-00-01.vwsmy77.mongodb.net:27017,ac-sfjv6wg-shard-00-02.vwsmy77.mongodb.net:27017/medicamentos?ssl=true&replicaSet=atlas-nitjzr-shard-0&authSource=admin&retryWrites=true&w=majority

# ---- Red y CORS ----
# Frontend y API comparten origen (nginx hace de proxy), así que no hace falta CORS.
# Solo defínalo con SPRING_PROFILES_ACTIVE=prod (admite únicamente orígenes https).
CORS_ORIGENES=
# IP fija de nginx en la red "publica" (subred 172.28.10.0/24 del compose). Es el único
# proxy de confianza: solo de él se acepta X-Forwarded-For para el límite de intentos de
# login. No ponga la subred entera: incluye la puerta de enlace y permitiría falsificar la IP.
NGINX_IP=172.28.10.10
