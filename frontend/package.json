{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:react && ng serve",
    "build": "npm run build:react && ng build",
    "build:react": "vite build --config react-medicamentos/vite.config.mts",
    "build:vercel": "npm run build:react && node scripts/configurar-api.mjs && ng build --configuration production,vercel",
    "watch": "ng build --watch --configuration development",
    "watch:react": "vite build --watch --config react-medicamentos/vite.config.mts",
    "test": "ng test",
    "test:react": "vitest run --config react-medicamentos/vite.config.mts",
    "lint": "ng lint",
    "format": "prettier --write \"{src,react-medicamentos}/**/*.{ts,tsx,html,scss,css}\"",
    "format:check": "prettier --check \"{src,react-medicamentos}/**/*.{ts,tsx,html,scss,css}\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
